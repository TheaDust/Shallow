# ShallowCode 网关配置模板
# 复制为仓库根目录的 .env 后填写；.env 已被 .gitignore 排除，不会入库。
# 真实环境变量优先于 .env 文件中的值。

# OpenAI-compatible 网关的 API key
OPENAI_API_KEY=

# 网关基础地址，例如 https://gateway.example.com/v1
OPENAI_BASE_URL=

# 模型名称，例如 provider/model
MODEL=

# 可选：运行日志（run-log.txt 与 run-ledger.jsonl）的存放目录。
# 缺省放在系统临时目录 %TMP%/shallowcode-runs/<运行ID>/；设置后仍按运行 ID 分子目录。
# SHALLOW_RUN_DIR=
