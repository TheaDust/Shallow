{"packetId":"packet-req-5-4","cases":[{"id":"close-reopen-issue-happy-path","requirementIds":["REQ-5-4"],"purpose":"happy_path","expectationBasis":["The detail page offers a “Close issue” button when Open and a “Reopen issue” button when Closed; activating either immediately saves the change without an additional confirmation.","Closing displays Closed status and a “Closed issue” activity, and reopening displays Open status.","After reopening and reload the “Close issue” button is available again."],"steps":[{"op":"goto","path":"/"},{"op":"click","locator":{"by":"role","role":"link","name":"Sign in","exact":true}},{"op":"fill","locator":{"by":"label","text":"Username or email","exact":true},"value":"alice-dev"},{"op":"fill","locator":{"by":"label","text":"Password","exact":true},"value":"Valid-password-123!"},{"op":"click","locator":{"by":"role","role":"button","name":"Sign in","exact":true}},{"op":"click","locator":{"by":"role","role":"link","name":"acme-docs","exact":false,"fallbacks":[{"by":"text","text":"acme-docs","exact":false}]}},{"op":"click","locator":{"by":"role","role":"link","name":"Issues","exact":true}},{"op":"click","locator":{"by":"role","role":"link","name":"Improve onboarding","exact":true}},{"op":"expectVisible","locator":{"by":"role","role":"heading","name":"Improve onboarding","exact":true}},{"op":"expectVisible","locator":{"by":"text","text":"Open","exact":true}},{"op":"click","locator":{"by":"role","role":"button","name":"Close issue","exact":true}},{"op":"expectVisible","locator":{"by":"text","text":"Closed","exact":true}},{"op":"expectVisible","locator":{"by":"text","text":"Closed issue","exact":true}},{"op":"reload"},{"op":"expectVisible","locator":{"by":"role","role":"button","name":"Reopen issue","exact":true}},{"op":"expectVisible","locator":{"by":"text","text":"Closed","exact":true}},{"op":"click","locator":{"by":"role","role":"button","name":"Reopen issue","exact":true}},{"op":"expectVisible","locator":{"by":"text","text":"Open","exact":true}},{"op":"expectVisible","locator":{"by":"role","role":"button","name":"Close issue","exact":true}},{"op":"reload"},{"op":"expectVisible","locator":{"by":"text","text":"Open","exact":true}},{"op":"expectVisible","locator":{"by":"role","role":"button","name":"Close issue","exact":true}}]},{"id":"close-reopen-reader-sees-no-controls","requirementIds":["REQ-5-4"],"purpose":"permission","expectationBasis":["Only users with Triage, Maintain, or Admin may close or reopen an issue from the issue detail view; Write and Read users may only view the status.","On the separate protected issue, the Read viewer sees neither close nor reopen button; hiding both controls is required, in addition to rejecting unauthorized requests.","Close and reopen operations are unavailable to that user or are rejected, and the issue status remains unchanged."],"steps":[{"op":"goto","path":"/"},{"op":"click","locator":{"by":"role","role":"link","name":"acme-docs","exact":false,"fallbacks":[{"by":"text","text":"acme-docs","exact":false}]}},{"op":"click","locator":{"by":"role","role":"link","name":"Issues","exact":true}},{"op":"click","locator":{"by":"role","role":"link","name":"Improve onboarding","exact":true}},{"op":"expectVisible","locator":{"by":"text","text":"Open","exact":true}},{"op":"expectHidden","locator":{"by":"role","role":"button","name":"Reopen issue","exact":true}},{"op":"expectHidden","locator":{"by":"role","role":"button","name":"Close issue","exact":true}}]}]}