ins the username and email input, displays an itemized message beside the corresponding field, and does not create an account."],"steps":[{"op":"goto","path":"/"},{"op":"click","locator":{"by":"role","role":"link","name":"Sign in","exact":true,"fallbacks":[{"by":"role","role":"button","name":"Sign in","exact":true}]}},{"op":"click","locator":{"by":"role","role":"link","name":"Create an account","exact":true,"fallbacks":[{"by":"role","role":"button","name":"Create an account","exact":true}]}},{"op":"fill","locator":{"by":"label","text":"Username","exact":true},"value":"alice-dev"},{"op":"fill","locator":{"by":"label","text":"Email","exact":true},"value":"new-user@example.test"},{"op":"fill","locator":{"by":"label","text":"Password","exact":true},"value":"Valid-password-123!"},{"op":"fill","locator":{"by":"label","text":"Confirm password","exact":true},"value":"Valid-password-123!"},{"op":"click","locator":{"by":"label","text":"Agree to the terms","exact":true}},{"op":"click","locator":{"by":"role","role":"button","name":"Create account","exact":true}},{"op":"expectVisible","locator":{"by":"text","text":"Username already exists","exact":true}},{"op":"expectValue","locator":{"by":"label","text":"Username","exact":true},"value":"alice-dev"},{"op":"expectValue","locator":{"by":"label","text":"Email","exact":true},"value":"new-user@example.test"},{"op":"expectVisible","locator":{"by":"text","text":"Username already exists","exact":true}}]}]}