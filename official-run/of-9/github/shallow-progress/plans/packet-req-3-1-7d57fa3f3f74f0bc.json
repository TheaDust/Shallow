{"packetId":"packet-req-3-1","cases":[{"id":"search-public-open-overview","requirementIds":["REQ-3-1"],"purpose":"happy_path","expectationBasis":["The top global search control has searchbox role and accessible name “Search”; entering a repository name and pressing Enter displays repository results directly, without requiring an additional type-filter click.","Each repository result has a link whose accessible name is exactly its repository name, while the result also displays its owner/name metadata. Clicking it opens a heading containing the repository name; reloading preserves that overview.","Users open a repository overview from global search results, a personal/organization Repositories list, or a direct link;"],"steps":[{"op":"goto","path":"/"},{"op":"expectVisible","locator":{"by":"role","role":"searchbox","name":"Search","exact":true}},{"op":"fill","locator":{"by":"role","role":"searchbox","name":"Search","exact":true},"value":"acme-docs"},{"op":"press","locator":{"by":"role","role":"searchbox","name":"Search","exact":true},"key":"Enter"},{"op":"expectVisible","locator":{"by":"role","role":"link","name":"acme-docs","exact":true,"scope":{"by":"role","role":"listitem","hasText":"acme-demo/acme-docs"}}},{"op":"click","locator":{"by":"role","role":"link","name":"acme-docs","exact":true,"scope":{"by":"role","role":"listitem","hasText":"acme-demo/acme-docs"}}},{"op":"expectVisible","locator":{"by":"role","role":"heading","name":"acme-docs","exact":false}},{"op":"reload"},{"op":"expectVisible","locator":{"by":"role","role":"heading","name":"acme-docs","exact":false}}],"setupStepCount":2},{"id":"visitor-private-search-no-link","requirementIds":["REQ-3-1"],"purpose":"permission","expectationBasis":["Seed data provides a named public repository and a private repository inaccessible to visitors; searching the private name exposes no result link for it.","The results page displays the public matching repository's “owner/repository name”, description, visibility, and update time, and does not display the unauthorized private repository"],"steps":[{"op":"goto","path":"/"},{"op":"expectVisible","locator":{"by":"role","role":"searchbox","name":"Search","exact":true}},{"op":"fill","locator":{"by":"role","role":"searchbox","name":"Search","exact":true},"value":"secret-research"},{"op":"press","locator":{"by":"role","role":"searchbox","name":"Search","exact":true},"key":"Enter"},{"op":"expectCount","locator":{"by":"role","role":"link","name":"secret-research","exact":true},"count":0}],"setupStepCount":2},{"id":"no-match-query-repeat-home","requirementIds":["REQ-3-1"],"purpose":"negative","expectationBasis":["A query with no matching repository displays “No results”, including when the visitor returns home and repeats the same query."],"steps":[{"op":"goto","path":"/"},{"op":"expectVisible","locator":{"by":"role","role":"searchbox","name":"Search","exact":true}},{"op":"fill","locator":{"by":"role","role":"searchbox","name":"Search","exact":true},"value":"does-not-exist"},{"op":"press","locator":{"by":"role","role":"searchbox","name":"Search","exact":true},"key":"Enter"},{"op":"expectText","locator":{"by":"text","text":"No results","exact":true},"text":"No results","exact":true},{"op":"goto","path":"/"},{"op":"expectVisible","locator":{"by":"role","role":"searchbox","name":"Search","exact":true}},{"op":"fill","locator":{"by":"role","role":"searchbox","name":"Search","exact":true},"value":"does-not-exist"},{"op":"press","locator":{"by":"role","role":"searchbox","name":"Search","exact":true},"key":"Enter"},{"op":"expectText","locator":{"by":"text","text":"No results","exact":true},"text":"No results","exact":true}],"setupStepCount":2}]}