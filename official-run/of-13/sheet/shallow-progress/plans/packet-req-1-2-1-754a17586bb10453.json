{"packetId":"packet-req-1-2-1","cases":[{"id":"create-blank-workbook-opens-blank-sheet1","requirementIds":["REQ-1-2-1"],"purpose":"happy_path","expectationBasis":["The home page provides a button with the accessible name \"New blank workbook\"; clicking it opens the creation page, whose submit button is named \"Create\".","After creation succeeds, the editor opens and shows only a blank worksheet named Sheet1, with Sheet1 active and A1 selected","the current cell and every cell within the currently selected rectangular region expose aria-selected=\"true\""],"steps":[{"op":"goto","path":"/"},{"op":"expectVisible","locator":{"by":"role","role":"button","name":"New blank workbook","exact":true}},{"op":"click","locator":{"by":"role","role":"button","name":"New blank workbook","exact":true}},{"op":"expectVisible","locator":{"by":"role","role":"button","name":"Create","exact":true}},{"op":"click","locator":{"by":"role","role":"button","name":"Create","exact":true}},{"op":"expectCount","locator":{"by":"role","role":"tab"},"count":1},{"op":"expectAttribute","locator":{"by":"role","role":"tab","name":"Sheet1","exact":true},"attribute":"aria-selected","value":"true"},{"op":"expectVisible","locator":{"by":"role","role":"grid","name":"Worksheet grid","exact":true}},{"op":"expectAttribute","locator":{"by":"role","role":"gridcell","name":"A1","exact":true},"attribute":"aria-selected","value":"true"}],"setupStepCount":2},{"id":"blank-workbook-state-persists-after-reload","requirementIds":["REQ-1-2-1"],"purpose":"persistence","expectationBasis":["Worksheet tabs on the same editor page use the ARIA tab role, with the active tab indicated by aria-selected=\"true\"","refreshing or returning to the home page and reopening produces the same state","with Sheet1 active and A1 selected"],"steps":[{"op":"goto","path":"/"},{"op":"expectVisible","locator":{"by":"role","role":"button","name":"New blank workbook","exact":true}},{"op":"click","locator":{"by":"role","role":"button","name":"New blank workbook","exact":true}},{"op":"click","locator":{"by":"role","role":"button","name":"Create","exact":true}},{"op":"expectAttribute","locator":{"by":"role","role":"tab","name":"Sheet1","exact":true},"attribute":"aria-selected","value":"true"},{"op":"reload"},{"op":"expectCount","locator":{"by":"role","role":"tab"},"count":1},{"op":"expectAttribute","locator":{"by":"role","role":"tab","name":"Sheet1","exact":true},"attribute":"aria-selected","value":"true"},{"op":"expectAttribute","locator":{"by":"role","role":"gridcell","name":"A1","exact":true},"attribute":"aria-selected","value":"true"}],"setupStepCount":5}]}