{"packetId":"packet-req-6-3-1","cases":[{"id":"view-pr-overview-commits-files","requirementIds":["REQ-6-3-1"],"purpose":"happy_path","expectationBasis":["A seeded public Open PR is directly viewable without sign-in and displays its exact title in a heading.","Commits and Files changed are links; the Commits view displays a Commit summary, and the Files changed view displays a Changed files summary.","Conversation is the timeline for the author's description, ordinary comments, review summaries, and status events; Commits is the list of commits on the PR's current compare branch relative to base; Files changed is the entry point to the current diff."],"steps":[{"op":"goto","path":"/"},{"op":"click","locator":{"by":"role","role":"link","name":"Improve onboarding","exact":true,"fallbacks":[{"by":"role","role":"link","name":"Improve onboarding","exact":false}]}},{"op":"expectVisible","locator":{"by":"role","role":"heading","name":"Improve onboarding","exact":true,"fallbacks":[{"by":"role","role":"heading","name":"Improve onboarding","exact":false}]}},{"op":"expectVisible","locator":{"by":"role","role":"link","name":"Conversation","exact":true}},{"op":"click","locator":{"by":"role","role":"link","name":"Commits","exact":true}},{"op":"expectText","locator":{"by":"text","text":"Commit summary","exact":false,"fallbacks":[{"by":"role","role":"heading","name":"Commit summary","exact":false}]},"text":"Commit summary","exact":false},{"op":"click","locator":{"by":"role","role":"link","name":"Files changed","exact":true}},{"op":"expectText","locator":{"by":"text","text":"Changed files summary","exact":false,"fallbacks":[{"by":"role","role":"heading","name":"Changed files summary","exact":false}]},"text":"Changed files summary","exact":false},{"op":"click","locator":{"by":"role","role":"link","name":"Conversation","exact":true}},{"op":"expectVisible","locator":{"by":"role","role":"heading","name":"Improve onboarding","exact":true,"fallbacks":[{"by":"role","role":"heading","name":"Improve onboarding","exact":false}]}}]},{"id":"view-pr-reload-persists","requirementIds":["REQ-6-3-1"],"purpose":"persistence","expectationBasis":["Reloading preserves the heading and usable navigation links; leaving and reopening the same visible page restores the same PR and allows the same navigation.","After refreshing any tab, the PR title, branches, and commits remain unchanged; viewing operations do not create comments, reviews, or branch updates."],"steps":[{"op":"goto","path":"/"},{"op":"click","locator":{"by":"role","role":"link","name":"Improve onboarding","exact":true,"fallbacks":[{"by":"role","role":"link","name":"Improve onboarding","exact":false}]}},{"op":"expectVisible","locator":{"by":"role","role":"heading","name":"Improve onboarding","exact":true,"fallbacks":[{"by":"role","role":"heading","name":"Improve onboarding","exact":false}]}},{"op":"reload"},{"op":"expectVisible","locator":{"by":"role","role":"heading","name":"Improve onboarding","exact":true,"fallbacks":[{"by":"role","role":"heading","name":"Improve onboarding","exact":false}]}},{"op":"click","locator":{"by":"role","role":"link","name":"Commits","exact":true}},{"op":"expectText","locator":{"by":"text","text":"Commit summary","exact":false,"fallbacks":[{"by":"role","role":"heading","name":"Commit summary","exact":false}]},"text":"Commit summary","exact":false}]}]}