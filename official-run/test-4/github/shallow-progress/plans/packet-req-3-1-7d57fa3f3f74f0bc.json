{"packetId":"packet-req-3-1","cases":[{"id":"visitor-search-open-repo","requirementIds":["REQ-3-1"],"purpose":"happy_path","expectationBasis":["The top global search control has searchbox role and accessible name “Search”; entering a repository name and pressing Enter displays repository results directly, without requiring an additional type-filter click.","Each repository result has a link whose accessible name is exactly its repository name, while the result also displays its owner/name metadata.","Clicking it opens a heading containing the repository name; reloading preserves that overview."],"steps":[{"op":"goto","path":"/"},{"op":"fill","locator":{"by":"role","role":"searchbox","name":"Search","exact":true},"value":"acme-docs"},{"op":"press","locator":{"by":"role","role":"searchbox","name":"Search","exact":true},"key":"Enter"},{"op":"expectVisible","locator":{"by":"role","role":"link","name":"acme-docs","exact":true,"scope":{"by":"role","role":"listitem","hasText":"acme-demo/acme-docs"}}},{"op":"click","locator":{"by":"role","role":"link","name":"acme-docs","exact":true,"scope":{"by":"role","role":"listitem","hasText":"acme-demo/acme-docs"}}},{"op":"expectVisible","locator":{"by":"role","role":"heading","name":"acme-docs","exact":false}},{"op":"reload"},{"op":"expectVisible","locator":{"by":"role","role":"heading","name":"acme-docs","exact":false}}]},{"id":"no-results-repeat-home","requirementIds":["REQ-3-1"],"purpose":"negative","expectationBasis":["A query with no matching repository displays “No results”, including when the visitor returns home and repeats the same query."],"steps":[{"op":"goto","path":"/"},{"op":"fill","locator":{"by":"role","role":"searchbox","name":"Search","exact":true},"value":"never-matching-repo-xyz"},{"op":"press","locator":{"by":"role","role":"searchbox","name":"Search","exact":true},"key":"Enter"},{"op":"expectVisible","locator":{"by":"text","text":"No results","exact":true}},{"op":"goto","path":"/"},{"op":"fill","locator":{"by":"role","role":"searchbox","name":"Search","exact":true},"value":"never-matching-repo-xyz"},{"op":"press","locator":{"by":"role","role":"searchbox","name":"Search","exact":true},"key":"Enter"},{"op":"expectVisible","locator":{"by":"text","text":"No results","exact":true}}]},{"id":"private-repo-hidden-from-visitor","requirementIds":["REQ-3-1"],"purpose":"permission","expectationBasis":["Seed data provides a named public repository and a private repository inaccessible to visitors; searching the private name exposes no result link for it.","Visitors or signed-in users can search repositories they are authorized to view."],"steps":[{"op":"goto","path":"/"},{"op":"fill","locator":{"by":"role","role":"searchbox","name":"Search","exact":true},"value":"secret-research"},{"op":"press","locator":{"by":"role","role":"searchbox","name":"Search","exact":true},"key":"Enter"},{"op":"expectCount","locator":{"by":"role","role":"link","name":"secret-research","exact":true},"count":0}]}]}