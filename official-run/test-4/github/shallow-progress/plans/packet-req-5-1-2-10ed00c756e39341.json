{"packetId":"packet-req-5-1-2","cases":[{"id":"view-open-issue-detail","requirementIds":["REQ-5-1-2"],"purpose":"happy_path","expectationBasis":["An issue detail page is the read view for a uniquely numbered work item within a repository — the top displays the number, a heading whose exact accessible name is the complete title without the issue number, and visible status text “Open” or “Closed”; the body displays the complete saved description as readable text; the right side displays assignees, labels, and milestone; and the bottom displays sections or records containing “Comment” or “Activity” text over time.","The seeded open issue title is `Improve onboarding` and its description is `Describe the onboarding improvement.`"],"steps":[{"op":"goto","path":"/"},{"op":"click","locator":{"by":"text","text":"acme-docs","exact":false}},{"op":"click","locator":{"by":"role","role":"link","name":"Issues","exact":true}},{"op":"click","locator":{"by":"role","role":"link","name":"Improve onboarding","exact":true}},{"op":"expectVisible","locator":{"by":"role","role":"heading","name":"Improve onboarding","exact":true}},{"op":"expectText","locator":{"by":"text","text":"Describe the onboarding improvement.","exact":true},"text":"Describe the onboarding improvement.","exact":true},{"op":"expectText","locator":{"by":"text","text":"Open","exact":true},"text":"Open","exact":true},{"op":"expectText","locator":{"by":"text","text":"bug","exact":true},"text":"bug","exact":true},{"op":"expectText","locator":{"by":"text","text":"documentation","exact":true},"text":"documentation","exact":true},{"op":"expectText","locator":{"by":"text","text":"Q3 launch","exact":true},"text":"Q3 launch","exact":true},{"op":"expectText","locator":{"by":"text","text":"Comment","exact":false},"text":"Comment","exact":false,"anyOf":["Activity","activity timeline","Activity timeline"]},{"op":"expectVisible","locator":{"by":"role","role":"heading","name":"Improve onboarding","exact":true}}]},{"id":"issue-detail-persists-after-reload","requirementIds":["REQ-5-1-2"],"purpose":"persistence","expectationBasis":["After refreshing or reopening the same number from the list, the same title, status, metadata, and saved comments are displayed"],"steps":[{"op":"goto","path":"/"},{"op":"click","locator":{"by":"text","text":"acme-docs","exact":false}},{"op":"click","locator":{"by":"role","role":"link","name":"Issues","exact":true}},{"op":"click","locator":{"by":"role","role":"link","name":"Improve onboarding","exact":true}},{"op":"expectVisible","locator":{"by":"role","role":"heading","name":"Improve onboarding","exact":true}},{"op":"expectText","locator":{"by":"text","text":"Describe the onboarding improvement.","exact":true},"text":"Describe the onboarding improvement.","exact":true},{"op":"reload"},{"op":"expectVisible","locator":{"by":"role","role":"heading","name":"Improve onboarding","exact":true}},{"op":"expectText","locator":{"by":"text","text":"Open","exact":true},"text":"Open","exact":true},{"op":"expectText","locator":{"by":"text","text":"Describe the onboarding improvement.","exact":true},"text":"Describe the onboarding improvement.","exact":true},{"op":"expectVisible","locator":{"by":"role","role":"heading","name":"Improve onboarding","exact":true}}]},{"id":"issue-detail-visible-to-signed-in-user","requirementIds":["REQ-5-1-2"],"purpose":"permission","expectationBasis":["Any user with repository-view permission may read this saved data, but the page displays editable controls only to users with the corresponding role.","The user signs in as `alice-dev` with `Valid-password-123!` and follows the visible controls for the view an issue and its discussion workflow.","All authenticated scenarios use the home-page “Sign in” link, fields labeled “Username or email” and “Password”, and the “Sign in” button, after which the signed-in username is visible."],"steps":[{"op":"goto","path":"/"},{"op":"click","locator":{"by":"role","role":"link","name":"Sign in","exact":true}},{"op":"fill","locator":{"by":"label","text":"Username or email","exact":true},"value":"alice-dev"},{"op":"fill","locator":{"by":"label","text":"Password","exact":true},"value":"Valid-password-123!"},{"op":"click","locator":{"by":"role","role":"button","name":"Sign in","exact":true}},{"op":"expectText","locator":{"by":"text","text":"alice-dev","exact":true},"text":"alice-dev","exact":true},{"op":"click","locator":{"by":"role","role":"link","name":"acme-docs","exact":true}},{"op":"click","locator":{"by":"role","role":"link","name":"Issues","exact":true}},{"op":"click","locator":{"by":"role","role":"link","name":"Improve onboarding","exact":true}},{"op":"expectVisible","locator":{"by":"role","role":"heading","name":"Improve onboarding","exact":true}},{"op":"expectText","locator":{"by":"text","text":"Describe the onboarding improvement.","exact":true},"text":"Describe the onboarding improvement.","exact":true},{"op":"expectVisible","locator":{"by":"role","role":"heading","name":"Improve onboarding","exact":true}}]}]}