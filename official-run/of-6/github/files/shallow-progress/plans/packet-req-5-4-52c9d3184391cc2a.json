{"packetId":"packet-req-5-4","cases":[{"id":"close-and-reopen-issue-happy-path","requirementIds":["REQ-5-4"],"purpose":"happy_path","expectationBasis":["Only users with Triage, Maintain, or Admin may close or reopen an issue from the issue detail view; Write and Read users may only view the status.","The detail page offers a “Close issue” button when Open and a “Reopen issue” button when Closed; activating either immediately saves the change without an additional confirmation.","Closing displays Closed status and a “Closed issue” activity, and reopening displays Open status. After reopening and reload the “Close issue” button is available again."],"steps":[{"op":"goto","path":"/"},{"op":"click","locator":{"by":"role","role":"link","name":"Sign in","exact":true}},{"op":"fill","locator":{"by":"label","text":"Username or email","exact":true},"value":"alice-dev"},{"op":"fill","locator":{"by":"label","text":"Password","exact":true},"value":"Valid-password-123!"},{"op":"click","locator":{"by":"role","role":"button","name":"Sign in","exact":true}},{"op":"click","locator":{"by":"role","role":"link","name":"acme-docs","exact":false}},{"op":"click","locator":{"by":"role","role":"link","name":"Issues","exact":true}},{"op":"click","locator":{"by":"role","role":"link","name":"Improve onboarding","exact":true,"scope":{"by":"role","role":"main"},"fallbacks":[{"by":"role","role":"link","name":"Improve onboarding","exact":false,"scope":{"by":"role","role":"main"}}]}},{"op":"expectVisible","locator":{"by":"role","role":"heading","name":"Improve onboarding","exact":true}},{"op":"expectVisible","locator":{"by":"role","role":"button","name":"Close issue","exact":true}},{"op":"click","locator":{"by":"role","role":"button","name":"Close issue","exact":true}},{"op":"expectVisible","locator":{"by":"role","role":"button","name":"Reopen issue","exact":true}},{"op":"expectVisible","locator":{"by":"text","text":"Closed issue","exact":true}},{"op":"click","locator":{"by":"role","role":"button","name":"Reopen issue","exact":true}},{"op":"expectVisible","locator":{"by":"role","role":"button","name":"Close issue","exact":true}},{"op":"reload"},{"op":"expectVisible","locator":{"by":"role","role":"button","name":"Close issue","exact":true}}]},{"id":"close-state-persists-after-reload","requirementIds":["REQ-5-4"],"purpose":"persistence","expectationBasis":["The system stores the Open or Closed status, operator, and time, records the transition in activity history, and shows it to subsequent viewers; the status transition must not modify the title, description, comments, labels, assignees, or milestone.","After reopening and reload the “Close issue” button is available again.","After refreshing the detail page and issue list, the final Open state remains consistent; for users without management permission, close or reopen operations are unavailable or rejected and the status does not change."],"steps":[{"op":"goto","path":"/"},{"op":"click","locator":{"by":"role","role":"link","name":"Sign in","exact":true}},{"op":"fill","locator":{"by":"label","text":"Username or email","exact":true},"value":"alice-dev"},{"op":"fill","locator":{"by":"label","text":"Password","exact":true},"value":"Valid-password-123!"},{"op":"click","locator":{"by":"role","role":"button","name":"Sign in","exact":true}},{"op":"click","locator":{"by":"role","role":"link","name":"acme-docs","exact":false}},{"op":"click","locator":{"by":"role","role":"link","name":"Issues","exact":true}},{"op":"click","locator":{"by":"role","role":"link","name":"Improve onboarding","exact":true,"scope":{"by":"role","role":"main"},"fallbacks":[{"by":"role","role":"link","name":"Improve onboarding","exact":false,"scope":{"by":"role","role":"main"}}]}},{"op":"expectVisible","locator":{"by":"role","role":"button","name":"Close issue","exact":true}},{"op":"click","locator":{"by":"role","role":"button","name":"Close issue","exact":true}},{"op":"expectVisible","locator":{"by":"role","role":"button","name":"Reopen issue","e