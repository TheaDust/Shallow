{"packetId":"packet-req-6-6","cases":[{"id":"close-and-reopen-pull-request","requirementIds":["REQ-6-6"],"purpose":"happy_path","expectationBasis":["Close pull request immediately sets Closed without an extra confirmation dialog, then Reopen pull request immediately restores Open. After reload, Close pull request is available again.","The PR displays Closed and Open in sequence, and the timeline records both status transitions; closing does not merge commits, update the target branch, or delete the discussion or diff.","Seed values: pull requests `Improve onboarding` and `Fix search`, branches `main` and `feature-search`, reviewer `bob-reviewer`, check `test`."],"steps":[{"op":"goto","path":"/"},{"op":"click","locator":{"by":"role","role":"link","name":"Sign in","exact":true}},{"op":"fill","locator":{"by":"label","text":"Username or email","exact":true},"value":"alice-dev"},{"op":"fill","locator":{"by":"label","text":"Password","exact":true},"value":"Valid-password-123!"},{"op":"click","locator":{"by":"role","role":"button","name":"Sign in","exact":true}},{"op":"click","locator":{"by":"role","role":"link","name":"acme-docs-fork","exact":true}},{"op":"click","locator":{"by":"role","role":"link","name":"Pull requests","exact":true}},{"op":"click","locator":{"by":"role","role":"link","name":"Improve onboarding","exact":true,"scope":{"by":"role","role":"main"},"fallbacks":[{"by":"role","role":"link","name":"Improve onboarding","exact":false,"scope":{"by":"role","role":"main"}}]}},{"op":"click","locator":{"by":"role","role":"button","name":"Close pull request","exact":true}},{"op":"expectVisible","locator":{"by":"role","role":"button","name":"Reopen pull request","exact":true}},{"op":"click","locator":{"by":"role","role":"button","name":"Reopen pull request","exact":true}},{"op":"expectVisible","locator":{"by":"role","role":"button","name":"Close pull request","exact":true}},{"op":"reload"},{"op":"expectVisible","locator":{"by":"role","role":"heading","name":"Improve onb