{"packetId":"packet-req-6-3-2","cases":[{"id":"inspect-changed-files-happy-path","requirementIds":["REQ-6-3-2"],"purpose":"happy_path","expectationBasis":["From a visible public pull request entry, a visitor activates the Files changed link and sees the known changed file path verbatim and visible aggregate text such as 3 additions, 1 deletions.","This public PR seed contains the same known changed-file path `src/search.ts` supplied for branch comparison, with one added file and one modified file; it requires no sign-in.","aggregate statistics show the current PR's number of changed files and line counts in the format “<addition count> additions, <deletion count> deletions”."],"steps":[{"op":"goto","path":"/"},{"op":"click","locator":{"by":"role","role":"link","name":"acme-docs","exact":true,"scope":{"by":"role","role":"main"},"fallbacks":[{"by":"role","role":"link","name":"acme-docs","exact":true},{"by":"text","text":"acme-docs","exact":true,"scope":{"by":"role","role":"main"}}]}},{"op":"click","locator":{"by":"role","role":"link","name":"Pull requests","exact":true}},{"op":"click","locator":{"by":"role","role":"link","name":"Fix search","exact":true}},{"op":"click","locator":{"by":"role","role":"link","name":"Files changed","exact":true}},{"op":"expectText","locator":{"by":"role","role":"main"},"text":"additions","exact":false},{"op":"expectText","locator":{"by":"role","role":"main"},"text":"deletions","exact":false},{"op":"reload"},{"op":"click","locator":{"by":"role","role":"link","name":"Files changed","exact":true}},{"op":"expectVisible","locator":{"by":"role","role":"link","name":"src/search.ts","exact":true,"fallbacks":[{"by":"role","role":"button","name":"src/search.ts","exact":true},{"by":"text","text":"src/search.ts","exact":true,"scope":{"by":"role","role":"main"}}]}}]}]}