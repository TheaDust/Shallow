{
  "name": "shallowcode",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "test:browser": "tsx --test test/browser/*.test.ts",
    "test:all": "npm run typecheck && npm test && npm run test:browser",
    "smoke:credentials": "tsx --test --test-name-pattern=\"credential smoke\" test/credential-smoke.test.ts",
    "build:main": "tsc -p tsconfig.build.json",
    "package:baseline": "node scripts/package-baseline.mjs",
    "package:main": "npm run build:main && node scripts/package-main.mjs",
    "start": "tsx index.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "@opencode-ai/sdk": "1.18.27",
    "@playwright/mcp": "0.0.80",
    "@playwright/test": "1.54.0",
    "opencode-ai": "^1.18.27",
    "undici": "^7.29.1",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@types/node": "20.19.43",
    "tsx": "4.23.13",
    "typescript": "7.0.2"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "opencode-ai@1.18.27": true
  }
}
